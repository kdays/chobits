# .env is loaded before config.yaml is unmarshaled. Values become environment
# variables, then matching YAML fields are overridden after defaults are applied.
#
# Naming rule:
#   CHOBITS_<YAML_PATH_IN_UPPER_SNAKE_CASE>
#
# Examples:
CHOBITS_APP_ENV=dev
CHOBITS_SERVER_ADDR=:8080
CHOBITS_DATABASE_DEFAULT=default
CHOBITS_DATABASE_CONNECTIONS_DEFAULT_MYSQL_DSN=root:password@tcp(127.0.0.1:3306)/app?charset=utf8mb4&parseTime=true&loc=Local
CHOBITS_DATABASE_CONNECTIONS_LOCAL_SQLITE_PATH=./data/local.db
CHOBITS_REDIS_ADDR=127.0.0.1:6379
CHOBITS_KDAYS_UC_API_HOST=
CHOBITS_KDAYS_UC_API_KEY=
CHOBITS_KDAYS_UC_SECRET=
