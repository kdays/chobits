APP_NAME := {{APP_NAME}}
BUILDINFO_PKG := {{MODULE}}/internal/buildinfo
GIT_VERSION := $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
GIT_COMMIT := $(shell git rev-parse --short=12 HEAD 2>/dev/null || echo unknown)
BUILD_TIME := $(shell date -u '+%Y-%m-%dT%H:%M:%SZ')
GO_LDFLAGS := -s -w -X $(BUILDINFO_PKG).Version=$(GIT_VERSION) -X $(BUILDINFO_PKG).Commit=$(GIT_COMMIT) -X $(BUILDINFO_PKG).BuildTime=$(BUILD_TIME)

.PHONY: run build test fmt tidy

run:
	go run -ldflags "$(GO_LDFLAGS)" ./cmd/server -config config.yaml

build:
	mkdir -p bin
	CGO_ENABLED=0 go build -trimpath -ldflags "$(GO_LDFLAGS)" -o bin/$(APP_NAME) ./cmd/server

test:
	go test ./...

fmt:
	go fmt ./...

tidy:
	go mod tidy
